# Copy this file to .env and put your PostgreSQL password in place of YOUR_PASSWORD.
# The "weekplan" database and its tables are created by: npm run db:migrate
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/weekplan?schema=public"
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Week plan: 1 production week + PM_WEEKS packing-material weeks.
PM_WEEKS=4
# Set to off to stop the Friday 05:00 automatic week plan.
AUTO_WEEK_PLAN=on
